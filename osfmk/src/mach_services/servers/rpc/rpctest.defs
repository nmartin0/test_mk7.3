/*
 * cmk1.1
 */

subsystem rpctest 7700;

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

userprefix remote_;

import "rpc_defs.h";

type string_t			= array[*:256] of char;


routine		call(
			object		: mach_port_t;
			args		: string_t
			);


routine		spin(
			object		: mach_port_t;
			args		: string_t
			);

routine		kill(
			object		: mach_port_t;
			args		: string_t
			);

routine		term(
			object		: mach_port_t;
			args		: string_t
			);

routine		nop(
			object		: mach_port_t;
			args		: string_t
			);

routine		quit(
			object		: mach_port_t;
			args		: string_t
			);


