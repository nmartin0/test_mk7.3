/*
 * cmk1.1
 */

/*
 *	File:   netmem_msg.defs
 *	Author: David L. Black
 *
 *	Mig interface for messages to simple netmemory server
 */

subsystem netmem_msg	417200;

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

/*
 *	Read data from the object
 */
routine netmem_read(
		object		: mach_port_t;
sreplyport	reply_to	: mach_port_make_send_once_t;
		offset		: vm_address_t;
out		value		: int);

/*
 *	Write data to the object
 */
routine netmem_write(
		object		: mach_port_t;
sreplyport	reply_to	: mach_port_make_send_once_t;
		offset		: vm_address_t;
		value		: int);

