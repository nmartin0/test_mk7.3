/*
 * cmk1.1
 */

/*
 *	File:   netmem_msg_reply.defs
 *	Author: David L. Black
 *
 *	Mig interface for reply messages from simple netmemory server
 */

subsystem netmem_msg_reply	417300;

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

type reply_port_t = MACH_MSG_TYPE_MOVE_SEND_ONCE
        ctype: mach_port_t;

/*
 *	Reply routine to complete a read operation.  Return the
 *	result of the operation and the value read.
 */

simpleroutine netmem_read_reply(
		reply_port	: reply_port_t;
		result 		: kern_return_t;
		value		: int);

/*
 *	Reply routine to compete a write operation.
 */

simpleroutine netmem_write_reply(
		reply_port	: reply_port_t;
		result 		: kern_return_t);
