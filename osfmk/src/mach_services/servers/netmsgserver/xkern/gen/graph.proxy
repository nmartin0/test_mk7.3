# This is an example graph.comp file.  graph.comp is divided into
# three sections, delimited by the character '@'.  Protocols listed in
# the first section are 'driver' protocols.  


@;

name=lproxy/udp
#	trace=TR_FULL_TRACE
#	trace=TR_DETAILED
#	trace=TR_EVENTS
#	trace=TR_MAJOR_EVENTS
	trace=TR_ERRORS
