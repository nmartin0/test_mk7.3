+	 * as fatal.
+	 *
+	 * It was first fixed at the tty_open() call site, which unblocked
+	 * opening the console and left every OTHER caller broken. The one
+	 * that mattered is ttioctl()'s TIOCSETA, which does
+	 *
+	 *   if (tp->t_param && (error = (*tp->t_param)(tp, t)))
+	 *           return (error);
+	 *
+	 * so getty, which does TIOCGETA and then TIOCSETA, read the
+	 * termios successfully and failed to set it:
+	 *
+	 *   getty: /dev/console: Inappropriate ioctl for device
+	 *
+	 * Fixing it here covers TIOCSETA, TIOCSETAW, TIOCSETAF and any
+	 * future caller, and is what the first fix should have done.
+	 *
+	 * What this does NOT do: it does not make the settings take
+	 * effect. The speeds and flags are simply not applied on a device
+	 * with no TTY_STATUS, exactly as the get path already assumed.
+	 * Nothing here can change a line discipline the driver does not
+	 * expose.
+	 */
+	if (error == D_INVALID_OPERATION)
+		error = D_SUCCESS;
+
 	return (error);
 }
 
